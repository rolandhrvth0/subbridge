#version 450
// Capture-card NV12 (as SubBridge copies it: Y plane w*h, then interleaved UV w*h/2, no padding) -> RGBA8.
// The JVA11 reports Rec.709 YCbCr, limited range (16-235 / 16-240). Chroma is upsampled bilinearly from its
// MPEG-2 positions (left-sited horizontally, centred vertically) like a proper video player – nearest-sample
// chroma gave blocky colour fringes on edges.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Src { uint data[]; } src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform PC { uint w; uint h; uint full_range; uint pad; } pc;

uint byte_at(uint i) { return (src.data[i >> 2] >> ((i & 3u) * 8u)) & 0xffu; }

vec2 uv_at(int cx, int cy) {
    cx = clamp(cx, 0, int(pc.w / 2u) - 1);
    cy = clamp(cy, 0, int(pc.h / 2u) - 1);
    uint i = pc.w * pc.h + uint(cy) * pc.w + uint(cx) * 2u;
    return vec2(float(byte_at(i)), float(byte_at(i + 1u)));
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.w || p.y >= pc.h) return;
    float Y = float(byte_at(p.y * pc.w + p.x));
    // chroma sample grid: x = 2i (left-sited), y = 2j + 0.5 (centred)
    float fx = float(p.x) * 0.5;
    float fy = (float(p.y) - 0.5) * 0.5;
    int x0 = int(floor(fx)), y0 = int(floor(fy));
    float ax = fx - float(x0), ay = fy - float(y0);
    vec2 c = mix(mix(uv_at(x0, y0), uv_at(x0 + 1, y0), ax), mix(uv_at(x0, y0 + 1), uv_at(x0 + 1, y0 + 1), ax), ay);
    float U = c.x - 128.0;
    float V = c.y - 128.0;
    float y = Y;
    if (pc.full_range == 0u) {
        y = (Y - 16.0) * (255.0 / 219.0);
        U *= 255.0 / 224.0;
        V *= 255.0 / 224.0;
    }
    vec3 rgb = vec3(y + 1.5748 * V, y - 0.1873 * U - 0.4681 * V, y + 1.8556 * U) / 255.0;
    imageStore(dst, ivec2(p), vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
